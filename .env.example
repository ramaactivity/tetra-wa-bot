# Env Tetra WA Bot. Salin ke `.env.local` (atau `.env`) lalu isi nilai aslinya.
# JANGAN commit file env (sudah di .gitignore). Loader membaca .env.local DULU
# lalu .env, jadi .env.local menang. Semua var di bawah opsional — kalau kosong,
# bot tetap jalan penuh pakai config.js (fitur terkait DB/availability OFF).

# ── Integrasi Tetra Ops (Supabase) ──
# Nilai sama dengan tetra-ops:
#   SUPABASE_URL              = NEXT_PUBLIC_SUPABASE_URL di tetra-ops
#   SUPABASE_SERVICE_ROLE_KEY = SUPABASE_SERVICE_ROLE_KEY di tetra-ops (server-only, bypass RLS)
# Kosong → integrasi DB OFF (rules pakai config.js, bukan Supabase bot_rules).
SUPABASE_URL=https://rdrkzwesykebhibcwcsj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Cek Ketersediaan Unit (endpoint Tetra Ops) ──
# Token Bearer untuk GET /api/availability. Kosong → fitur cek slot OFF (bot tetap
# jalan, notif admin tanpa baris ketersediaan). Generate dari sisi Tetra Ops.
AVAILABILITY_API_TOKEN=
# Opsional — override URL endpoint. Default sudah ke produksi Tetra Ops.
# AVAILABILITY_API_URL=https://tetra-ops-lac.vercel.app/api/availability

# ── Healthcheck (opsional) ──
# Kalau diisi, bot ping URL ini saat berhasil connect (uptime monitor).
# HEALTHCHECK_URL=
